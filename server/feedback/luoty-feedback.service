[Unit]
Description=LuoTy Agent feedback collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luoty-feedback
Group=luoty-feedback
WorkingDirectory=/opt/luoty-feedback
ExecStart=/usr/bin/python3 /opt/luoty-feedback/app.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/luoty-feedback
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M
TasksMax=64

[Install]
WantedBy=multi-user.target
